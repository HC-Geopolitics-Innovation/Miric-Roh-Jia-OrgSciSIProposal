# Copy this file to .env in this folder and fill in the keys. .env is listed in .gitignore; this template is tracked.
# Never paste a key into a notebook. Every D1 notebook reads its key from the environment or from this file.

# GovInfo API (D1.1.1, D1.1.2). Free: register at https://api.data.gov/signup/; the key arrives by email and works at once.
GOVINFO_API_KEY=

# C-SPAN Archives API (D1.2.1). Request a key from api@c-spanarchives.org; it is not self-serve.
CSPAN_API_KEY=

# sec-api.io (D1.3.1, D1.3.3). A paid subscription that covers the bulk 10-K dataset and the Extractor API.
SEC_API_KEY=
