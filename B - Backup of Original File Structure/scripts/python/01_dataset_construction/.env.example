# Copy to .env in this directory and fill in. .env is gitignored; this template is not.
#
# Register a free key at https://api.data.gov/signup/ — it arrives by email and
# works immediately. A registered key is allowed 40 requests/second and 1,200
# per minute, which is far more than lib/govinfo.py asks for.
#
# Do not paste a key into a notebook or a .py file. The collector this project
# replaces carried four of them as string literals in tracked source.
GOVINFO_API_KEY=

# C-SPAN Video Library API key. Request one from C-SPAN; it is not self-serve.
CSPAN_API_KEY=

# A second GovInfo key. The hearing download and the Congressional Record
# collection run concurrently; giving each its own key keeps either from
# spending the other's rate limit.
GOVINFO_API_KEY_CREC=
